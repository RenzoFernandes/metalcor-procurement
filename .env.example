# Copie para .env (que não vai para o git). Todos os valores abaixo são de
# desenvolvimento local, fictícios e sem valor fora da sua máquina. Nunca reutilize em produção.

# Porta do PostgreSQL no host (5432 por padrão)
DB_PORT=5432

# Dono do banco (usado pelo Flyway para aplicar as migrações)
DB_USER=metalcor
DB_PASSWORD=metalcor_dev

# Usuário da API (privilégio mínimo, criado na migração V10)
APP_DB_PASSWORD=metalcor_app_dev

# Usuário somente leitura (copiloto e consultas, criado na migração V10)
READONLY_DB_PASSWORD=metalcor_readonly_dev


# --- API (lidas pelo Spring Boot; o Docker Compose só usa as variáveis acima) ---

# Conexão da API com o banco (padrões: localhost, 5432, metalcor)
DB_HOST=localhost
DB_NAME=metalcor
APP_DB_USER=metalcor_app
# Usuário somente leitura do copiloto (senha em READONLY_DB_PASSWORD, acima)
READONLY_DB_USER=metalcor_readonly

# Origem do frontend liberada no CORS (obrigatória em produção; em dev o padrão é o Vite)
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Copiloto: "ollama" (local, padrão) ou "gemini" (hospedado)
COPILOT_PROVIDER=ollama

# Gemini (só se COPILOT_PROVIDER=gemini). Nunca commite a chave real.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Ollama (só se COPILOT_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
