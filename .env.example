# Copie para .env (que não vai para o git). Todos os valores abaixo são de
# desenvolvimento local, fictícios e sem valor fora da sua máquina. Nunca reutilize em produção.

# Porta do PostgreSQL no host (5432 por padrão)
DB_PORT=5432

# Dono do banco (usado pelo Flyway para aplicar as migrações)
DB_USER=metalcor
DB_PASSWORD=metalcor_dev

# Usuário da API (privilégio mínimo, criado na migração V10)
APP_DB_PASSWORD=metalcor_app_dev

# Usuário somente leitura (copiloto e consultas, criado na migração V10)
READONLY_DB_PASSWORD=metalcor_readonly_dev
